{
    "name": "@tak-ps/node-tak",
    "type": "module",
    "version": "12.38.0",
    "description": "Lightweight JavaScript library for communicating with TAK Server",
    "author": "Nick Ingalls <nick@ingalls.ca>",
    "main": "dist/index.js",
    "types": "index.ts",
    "bin": {
        "tak": "./cli.ts"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./lib/*": "./dist/lib/*.js",
        "./lib/api/*": "./dist/lib/api/*.js"
    },
    "engines": {
        "node": ">= 22"
    },
    "scripts": {
        "test": "c8 --reporter=lcov --reporter html tsx --test test/*.ts",
        "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
        "doc": "typedoc index.ts",
        "build": "node node_modules/typescript7/bin/tsc --build",
        "pretest": "npm run lint"
    },
    "dependencies": {
        "@openaddresses/batch-error": "^2.12.0",
        "@sinclair/typebox": "^0.34.41",
        "@tak-ps/node-p12": "^1.0.1",
        "@tak-ps/xml-js": "^2.0.3",
        "mime": "^4.0.7",
        "pem": "^1.14.8",
        "undici": "^8.0.0"
    },
    "peerDependencies": {
        "@tak-ps/node-cot": "^14.52.0"
    },
    "devDependencies": {
        "@inquirer/prompts": "^8.0.1",
        "@types/node": "^26.0.0",
        "@types/pem": "^1.14.4",
        "c8": "^12.0.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2007",
        "tsx": "^4.19.4",
        "typedoc": "^0.28.1",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript7": "npm:typescript@^7.0.2"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/dfpc-coe/node-tak"
    },
    "keywords": [
        "tak",
        "atak",
        "wintak",
        "cot",
        "cusor",
        "target",
        "tactical"
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/dfpc-coe/node-tak/issues"
    },
    "homepage": "https://github.com/dfpc-coe/node-tak#readme"
}
